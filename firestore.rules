rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function isMember(familyId) {
      return signedIn()
        && request.auth.uid in familyDoc(familyId).memberUids;
    }

    function isParentOf(familyId) {
      let f = familyDoc(familyId);
      return signedIn() && (
        ('parentUids' in f && request.auth.uid in f.parentUids)
        || f.adminUid == request.auth.uid
      );
    }

    function isParentOnResource() {
      return signedIn() && (
        ('parentUids' in resource.data && request.auth.uid in resource.data.parentUids)
        || resource.data.adminUid == request.auth.uid
      );
    }

    function isMemberOnResource() {
      return signedIn() && request.auth.uid in resource.data.memberUids;
    }

    // Keys members must never change (identity / admin / settings)
    function memberTouchedProtectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['members', 'memberUids', 'parentUids', 'adminUid', 'settings', 'createdAt']);
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /invites/{inviteId} {
      allow get: if signedIn();
      allow list: if signedIn()
        && request.query.limit <= 50
        && isMember(resource.data.familyId);

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['familyId', 'role', 'createdBy', 'used', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.used == false
        && isParentOf(request.resource.data.familyId);

      allow update: if signedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.role == resource.data.role;

      allow delete: if signedIn() && isParentOf(resource.data.familyId);
    }

    match /families/{familyId} {
      allow read: if isMemberOnResource();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.adminUid == request.auth.uid
        && request.auth.uid in request.resource.data.parentUids
        && request.resource.data.parentUids.size() == 1;

      // Parent: full update.
      // Member: any content fields OK, but cannot touch identity/admin/settings.
      // Invite join: add self only.
      allow update: if signedIn() && (
        (
          isParentOnResource()
          && request.auth.uid in request.resource.data.memberUids
        )
        || (
          isMemberOnResource()
          && !isParentOnResource()
          && request.resource.data.memberUids == resource.data.memberUids
          && request.resource.data.adminUid == resource.data.adminUid
          && !memberTouchedProtectedKeys()
        )
        || (
          !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberUids', 'parentUids', 'updatedAt', 'lastInviteCode'])
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInviteCode)).data.familyId == familyId
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInviteCode)).data.used == true
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInviteCode)).data.usedBy == request.auth.uid
        )
      );

      allow delete: if signedIn() && resource.data.adminUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && isMember(familyId)
          && (request.auth.uid == resource.data.fromUid
              || request.auth.uid == resource.data.toUid);

        allow create: if signedIn()
          && isMember(familyId)
          && request.resource.data.keys().hasAll(['fromId', 'toId', 'fromUid', 'toUid', 'text', 'timestamp', 'read'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.read == false
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update: if signedIn()
          && isMember(familyId)
          && request.auth.uid == resource.data.toUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true
          && request.resource.data.fromUid == resource.data.fromUid
          && request.resource.data.toUid == resource.data.toUid
          && request.resource.data.text == resource.data.text;

        allow delete: if signedIn()
          && isMember(familyId)
          && (request.auth.uid == resource.data.fromUid
              || isParentOf(familyId));
      }
    }
  }
}
